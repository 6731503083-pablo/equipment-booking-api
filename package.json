{
  "name": "equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply equipment-booking-db --local",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply equipment-booking-db --local",
    "test:curl": "bash tests/curl-tests.sh"
  },
  "dependencies": {
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
